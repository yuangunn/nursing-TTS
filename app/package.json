{
  "name": "nursing-tts-app",
  "version": "0.1.0",
  "description": "간호기록 음성 녹음 생성기 (데스크탑)",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"npm:electron:dev\"",
    "electron:dev": "tsc -p electron/tsconfig.json && wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build": "tsc -p tsconfig.json --noEmit && vite build && tsc -p electron/tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "kr.nursing.tts",
    "productName": "NursingTTS",
    "directories": { "output": "release" },
    "files": ["dist/**", "dist-electron/**", "package.json"],
    "extraResources": [
      { "from": "../backend", "to": "backend", "filter": ["**/*", "!.venv/**", "!**/__pycache__/**", "!tests/**", "!local_data/**"] }
    ],
    "win": { "target": ["nsis"] },
    "mac": { "target": ["dmg"], "category": "public.app-category.medical" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
